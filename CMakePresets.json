{
    "version": 3,
    "configurePresets": [
        {
            "name": "ninja-examples",
            "displayName": "Build with examples using Ninja",
            "description": "Configure with MAZE_BUILDER_EXAMPLES=1 into build-ninja/",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build-ninja",
            "cacheVariables": {
                "MAZE_BUILDER_EXAMPLES": "1",
                "MAZE_BUILDER_TESTS": "1"
            }
        },
        {
            "name": "wasmjs-examples",
            "generator": "Ninja Multi-Config",
            "displayName": "Build the examples using EMSDK",
            "description": "Configure with MAZE_BUILDER_EXAMPLES=1 into build-wasmjs/",
            "binaryDir": "${sourceDir}/build-wasmjs",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "DEBUG",
                "MAZE_BUILDER_EXAMPLES": "1",
                "CMAKE_MAKE_PROGRAM": "Ninja Multi-Config",
                "CMAKE_C_COMPILER": "emcc",
                "CMAKE_CXX_COMPILER": "em++"
            }
        },
        {
            "name": "msvc-examples",
            "displayName": "msvc: examples - Visual Studio Community 2022 Release - amd64",
            "description": "Using compilers for Visual Studio 17 2022 (x64 architecture)",
            "generator": "Visual Studio 17 2022",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build-msvc",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "MAZE_BUILDER_EXAMPLES": "1",
                "MAZE_BUILDER_TESTS": "1"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-examples",
            "displayName": "Visual Studio Community 2022 Release - amd64 - Release",
            "configurePreset": "msvc-examples",
            "configuration": "Release"
        }
    ]
}
